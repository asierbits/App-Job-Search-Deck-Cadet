# Copia este archivo como .env y rellena lo que necesites. Todas las variables empiezan por KNOK_.

# --- Básico
KNOK_ENV=development
KNOK_DATABASE_URL=postgresql+psycopg://postgres:knok@localhost:5432/knok
# Cámbiala en producción (cifra los tokens de Gmail/InfoJobs guardados). Ej.: python -c "import secrets;print(secrets.token_urlsafe(48))"
KNOK_SECRET_KEY=cambia-esto-en-produccion
# URL pública de esta API (para los callbacks de OAuth) y de tu web (adónde volver tras conectar Gmail)
KNOK_PUBLIC_BASE_URL=http://localhost:8000
KNOK_WEB_BASE_URL=http://localhost:3000
# Orígenes que pueden llamar a la API desde el navegador (tu web). Separados por comas.
KNOK_CORS_ORIGINS=http://localhost:3000
KNOK_STORAGE_DIR=./storage
# Cuentas con rol admin (revisan el diccionario de preguntas). Separadas por comas.
KNOK_ADMIN_EMAILS=

# --- Modo sin red: las búsquedas usan los datos de ejemplo de cada pack (ideal para probar)
KNOK_OFFLINE_SOURCES=false
# Worker dentro de la API (un solo proceso; uso local con SQLite: KNOK_DATABASE_URL=sqlite:///./knok.db)
KNOK_EMBEDDED_WORKER=false
# Ejecuta las tareas en el acto en vez de en el worker (solo tests/demos)
KNOK_TASKS_EAGER=false
# Cómo se identifica el rastreador ante las webs (pon la URL de una página que explique qué hace)
KNOK_CRAWLER_USER_AGENT=knok-bot/0.1 (+https://tu-dominio/bot; busca contactos de empleo publicados)

# --- Google OAuth (Gmail, solo envío: scope gmail.send)
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web)
# URI de redirección autorizada: {KNOK_PUBLIC_BASE_URL}/connections/google/callback
KNOK_GOOGLE_CLIENT_ID=
KNOK_GOOGLE_CLIENT_SECRET=
KNOK_GMAIL_DAILY_CAP=500

# --- Adzuna (plan gratis: https://developer.adzuna.com/)
KNOK_ADZUNA_APP_ID=
KNOK_ADZUNA_APP_KEY=
KNOK_ADZUNA_MONTHLY_QUOTA=1000

# --- InfoJobs (https://developer.infojobs.net/) — redirección: {KNOK_PUBLIC_BASE_URL}/connections/infojobs/callback
KNOK_INFOJOBS_CLIENT_ID=
KNOK_INFOJOBS_CLIENT_SECRET=

# --- Reenvío de respuestas (opcional): dominio que recibe u-<token>@dominio y secreto del receptor
KNOK_INBOUND_DOMAIN=in.knok.app
KNOK_INBOUND_SECRET=

# --- Punto de extensión "sugerir respuesta": vacío = desactivado (knok funciona sin IA)
KNOK_SUGGEST_REPLY_PROVIDER=
